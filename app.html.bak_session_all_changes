async function startApp() {
    try {
        updateProgress('🔍 Проверка обновлений...', 30);
        const updateInfo = await updateManager.checkForUpdate();
        
        if (updateInfo.hasUpdate) {
            document.getElementById('loading-screen').classList.add('hidden');
            document.getElementById('update-screen').classList.add('active');
            document.getElementById('update-current-version').textContent = updateInfo.currentVersion;
            document.getElementById('update-new-version').textContent = updateInfo.newVersion;
            return;
        }
        
        document.getElementById('loading-screen').classList.add('hidden');
        document.getElementById('login-screen').classList.add('active');
        document.getElementById('appVersionDisplay').textContent = 'Версия: ' + APP_VERSION;
        document.getElementById('loading-version').textContent = 'Версия: ' + APP_VERSION;
    } catch(e) {
        console.error('Ошибка запуска:', e);
        document.getElementById('loading-status').textContent = '❌ Ошибка запуска. Перезагрузите приложение.';
    }
}

// ==========================================
// ВХОД (ПРОВЕРКА ПИН-КОДА)
// ==========================================
function login() {
    const pinInput = document.getElementById('pin-input');
    const statusEl = document.getElementById('login-status');
    const loginBtn = document.getElementById('login-btn');
    const pin = pinInput.value.trim();
    
    pinInput.classList.remove('error');
    
    if (!pin) {
        pinInput.classList.add('error');
        statusEl.textContent = '❌ Введите код доступа';
        statusEl.className = 'status error';
        return;
    }
    
    loginBtn.disabled = true;
    statusEl.textContent = '⏳ Проверка...';
    statusEl.className = 'status loading';
    
    setTimeout(() => {
        if (pin === APP_PIN) {
            statusEl.textContent = '✅ Доступ разрешен!';
            statusEl.className = 'status success';
            localStorage.removeItem('app_pin');
            document.getElementById('login-screen').classList.remove('active');
            document.getElementById('login-screen').classList.add('hidden');
            const transitionScreen = document.getElementById('transition-screen');
            transitionScreen.classList.add('active');
            setTimeout(() => {
                transitionScreen.classList.remove('active');
                document.getElementById('app-container').classList.add('active');
                if (typeof initializeApp === 'function') {
                    initializeApp();
                }
            }, 2000);
        } else {
            statusEl.textContent = '❌ Неверный код доступа';
            statusEl.className = 'status error';
            pinInput.classList.add('error');
            pinInput.value = '';
            pinInput.focus();
        }
        loginBtn.disabled = false;
    }, 500);
}

document.getElementById('pin-input').addEventListener('input', function() {
    this.classList.remove('error');
    document.getElementById('login-status').textContent = '';
    document.getElementById('login-status').className = 'status';
});

document.addEventListener('keydown', function(e) {
    if (e.key === 'Enter') {
        const active = document.activeElement;
        if (active && active.id === 'pin-input') {
            login();
        }
    }
});

window.addEventListener('beforeunload', function(e) {
    const appContainer = document.getElementById('app-container');
    if (appContainer.classList.contains('active')) {
        e.preventDefault();
        e.returnValue = 'Вы уверены, что хотите перезагрузить страницу? Все несохранённые данные будут потеряны.';
        return e.returnValue;
    }
});

document.addEventListener('DOMContentLoaded', function() {
    // ====================================================================
    // ==== АВТОМАТИЧЕСКАЯ ПОДСТАНОВКА ВЕРСИИ ПРИЛОЖЕНИЯ (APP_VERSION) ====
    // ====================================================================
    const versionTargets = [
        { el: document.getElementById('loading-version'),        text: 'Версия: ' + APP_VERSION },
        { el: document.getElementById('appVersionDisplay'),      text: 'Версия: ' + APP_VERSION },
        { el: document.getElementById('update-current-version'), text: APP_VERSION },
        { el: document.getElementById('update-new-version'),     text: APP_VERSION }
    ];
    versionTargets.forEach(function(item) {
        if (item.el) item.el.textContent = item.text;
    });
    const versionMeta = document.querySelector('meta[name="app-version"]');
    if (versionMeta) versionMeta.setAttribute('content', APP_VERSION);

    document.getElementById('app-container').classList.remove('active');
    document.getElementById('login-screen').classList.remove('active');
    document.getElementById('login-screen').classList.remove('hidden');
    document.getElementById('update-screen').classList.remove('active');
    startApp();
});

