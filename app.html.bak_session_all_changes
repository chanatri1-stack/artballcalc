<script>
// ====================================================================
// ========= СОБСТВЕННЫЕ УВЕДОМЛЕНИЯ (вместо alert/confirm) ===========
// ====================================================================
(function () {
    var alertModal      = document.getElementById('alert-modal');
    var alertTitle      = document.getElementById('alert-title');
    var alertBody       = document.getElementById('alert-body');
    var okBtn           = document.getElementById('alert-ok-btn');
    var confirmBtn      = document.getElementById('alert-confirm-btn');
    var cancelBtn       = document.getElementById('alert-cancel-btn');
    var confirmCallback = null;

    function hideAppModal() {
        alertModal.classList.remove('active');
        confirmCallback = null;
        confirmBtn.style.display = 'none';
        cancelBtn.style.display = 'none';
        okBtn.style.display = '';
        alertTitle.innerHTML = '<i class="fas fa-exclamation-triangle"></i> Ошибка';
        alertBody.innerHTML = '';
    }

    function buildContent(text) {
        if (text && text.nodeType === 1) {
            alertBody.innerHTML = '';
            alertBody.appendChild(text);
            return;
        }
        var str = String(text == null ? '' : text);
        if (str.indexOf('\n') !== -1) {
            var items = str.split('\n')
                .map(function (s) { return s.trim(); })
                .filter(function (s) { return s.length > 0; });
            alertBody.innerHTML = '<ul>' + items.map(function (s) {
                return '<li>' + s.replace(/^[-•*]\s*/, '') + '</li>';
            }).join('') + '</ul>';
        } else {
            alertBody.textContent = str;
        }
    }

    window.showAppAlert = function (text) {
        hideAppModal();
        buildContent(text);
        alertModal.classList.add('active');
    };

    window.showAppConfirm = function (message, onConfirm) {
        hideAppModal();
        buildContent(message);
        alertTitle.innerHTML = '<i class="fas fa-question-circle"></i> Подтверждение';
        confirmCallback = typeof onConfirm === 'function' ? onConfirm : null;
        okBtn.style.display = 'none';
        confirmBtn.style.display = '';
        cancelBtn.style.display = '';
        alertModal.classList.add('active');
    };

    okBtn.addEventListener('click', hideAppModal);
    confirmBtn.addEventListener('click', function () {
        var cb = confirmCallback;
        hideAppModal();
        if (cb) cb();
    });
    cancelBtn.addEventListener('click', hideAppModal);
    alertModal.addEventListener('click', function (e) {
        if (e.target === alertModal) hideAppModal();
    });
    document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape' && alertModal.classList.contains('active')) hideAppModal();
    });

    // Все системные alert() теперь показываются в собственном окне приложения
    window.alert = function (msg) { window.showAppAlert(msg); };
})();
</script>

