function initializeApp() {
    document.getElementById('appVersionDisplay').textContent = 'Версия: ' + APP_VERSION;

    let currentWeapon = null;
    let isFlatTrajectory = false;
    let calculationHistory = [];

    // Получаем список всех доступных орудий
    function getAvailableWeapons() {
        const weapons = new Set();
        Object.keys(mortarData).forEach(key => weapons.add(key));
        Object.keys(flatData).forEach(key => weapons.add(key));
        return Array.from(weapons);
    }

    function getWeaponName(weaponKey) {
        if (mortarData[weaponKey]) return mortarData[weaponKey].name;
        if (flatData[weaponKey]) return flatData[weaponKey].name;
        return weaponKey;
    }

    function getCurrentDataSource() { 
        return isFlatTrajectory ? flatData[currentWeapon] : mortarData[currentWeapon]; 
    }

    function hasWeaponData() {
        return !!(mortarData[currentWeapon] || flatData[currentWeapon]);
    }

    function getGlobalRange() {
        const src = getCurrentDataSource();
        if (!src || !src.ranges) return { min: 0, max: 20000 };
        let minVal = Infinity, maxVal = -Infinity;
        src.ranges.forEach(r => { if (r.min < minVal) minVal = r.min; if (r.max > maxVal) maxVal = r.max; });
        return { min: minVal, max: maxVal };
    }

    function getChargeRange(charge) {
        const src = getCurrentDataSource();
        if (!src || !src.ranges) return null;
        return src.ranges.find(r => r.charge == charge) || null;
    }

    // Новая функция: проверяет, попадает ли дальность в любой из диапазонов зарядов
    function isDistanceInAnyChargeRange(dist) {
        const src = getCurrentDataSource();
        if (!src || !src.ranges) return false;
        return src.ranges.some(r => dist >= r.min && dist <= r.max);
    }

    function validateDistanceInput() {
        const distInput = document.getElementById('distance');
        const errorDiv = document.getElementById('distance-error');
        const auto = document.getElementById('auto-charge-toggle').checked;
        let rawValue = parseFloat(distInput.value);
        let isValid = true;
        let errorMsg = '';
        let minD = 0, maxD = 0;

        // Сначала проверяем, есть ли данные для орудия
        if (!hasWeaponData()) {
            distInput.classList.add('error');
            errorDiv.innerText = '⚠️ Нет данных для выбранного орудия. Заполните mortarData или flatData.';
            errorDiv.classList.add('show');
            document.getElementById('distance-range').innerHTML = '⚠️ Заполните данные для орудия';
            return false;
        }

        // Получаем общий диапазон или диапазон конкретного заряда
        if (auto) {
            // При автоподборе проверяем, попадает ли дальность в любой из диапазонов зарядов
            const global = getGlobalRange();
            minD = global.min;
            maxD = global.max;
        } else {
            let charge = parseInt(document.getElementById('charge').value);
            const rangeObj = getChargeRange(charge);
            if (rangeObj) {
                minD = rangeObj.min;
                maxD = rangeObj.max;
            } else {
                minD = 0;
                maxD = 20000;
            }
        }

        // Проверка на пустое или нечисловое значение
        if (isNaN(rawValue) || distInput.value.trim() === '') {
            isValid = false;
            errorMsg = `Введите числовое значение (${minD} - ${maxD} м)`;
        } 
        // Проверка выхода за пределы общего диапазона
        else if (rawValue < minD) {
            isValid = false;
            errorMsg = `Дальность не может быть меньше ${minD} м`;
        } else if (rawValue > maxD) {
            isValid = false;
            errorMsg = `Дальность не может быть больше ${maxD} м`;
        } 
        // Дополнительная проверка: при автоподборе проверяем попадание в любой из диапазонов зарядов
        else if (auto && !isDistanceInAnyChargeRange(rawValue)) {
            isValid = false;
            errorMsg = 'Дальность не попадает в диапазон зарядов';
        }

        if (!isValid) {
            distInput.classList.add('error');
            errorDiv.innerText = errorMsg;
            errorDiv.classList.add('show');
        } else {
            distInput.classList.remove('error');
            errorDiv.classList.remove('show');
        }

        document.getElementById('distance-range').innerHTML = `Допустимый диапазон: ${minD} - ${maxD} м`;
        return isValid;
    }

    function findBestChargeAuto(dist, oh, th) {
        const src = getCurrentDataSource();
        if (!src) return src.minCharge || 0;
        let bestCharge = src.minCharge || 0;
        let found = false;
        for (let c = src.minCharge || 0; c <= (src.maxCharge || 0); c += (src.step || 1)) {
            const rangeObj = src.ranges.find(r => r.charge == c);
            if (!rangeObj) continue;
            if (dist < rangeObj.min || dist > rangeObj.max) continue;
            const table = src.data[c];
            if (!table) continue;
            let sorted = [...table].sort((a,b)=>a[0]-b[0]);
            for (let i=0; i<sorted.length-1; i++) {
                if (sorted[i][0] <= dist && dist <= sorted[i+1][0]) {
                    bestCharge = c;
                    found = true;
                    break;
                }
            }
            if (found) break;
        }
        return found ? bestCharge : (src.minCharge || 0);
    }

    function getUpperLowerData(table, dist) {
        let sorted = [...table].sort((a, b) => a[0] - b[0]);

        if (dist < sorted[0][0]) {
            return { upper: sorted[0], lower: sorted[1], exact: false };
        }
        if (dist > sorted[sorted.length - 1][0]) {
            return { upper: sorted[sorted.length - 2], lower: sorted[sorted.length - 1], exact: false };
        }

        for (let i = 0; i < sorted.length - 1; i++) {
            const current = sorted[i];
            const next = sorted[i + 1];
            if (dist >= current[0] && dist <= next[0]) {
                if (dist === current[0]) {
                    return { exactMatch: current, exact: true };
                }
                if (dist === next[0]) {
                    return { exactMatch: next, exact: true };
                }
                return { upper: current, lower: next, exact: false };
            }
        }
        return null;
    }

    function calculateFull(dist, oh, th, charge = null) {
        const src = getCurrentDataSource();
        if (!src) throw new Error('Нет данных для выбранного орудия');

        const auto = document.getElementById('auto-charge-toggle').checked;
        let effectiveCharge = charge;

        if (auto) {
            effectiveCharge = findBestChargeAuto(dist, oh, th);
        } else if (charge === null) {
            effectiveCharge = src.minCharge || 0;
        }

        const table = src.data[effectiveCharge];
        if (!table) throw new Error(`Нет таблицы для заряда ${effectiveCharge}`);

        const ud = getUpperLowerData(table, dist);
        if (!ud) throw new Error('Не удалось определить данные для интерполяции');

        let finalElev, flightTime, rangeCorr, heightCorr;
        const heightDiff = oh - th;

        if (ud.exact) {
            const exactRow = ud.exactMatch;
            const baseElev = exactRow[1];
            flightTime = exactRow[4] || 0;
            const heightCorrRaw = exactRow[2] || 0;
            heightCorr = (heightDiff / 100) * heightCorrRaw;
            finalElev = baseElev + heightCorr;
            rangeCorr = baseElev;

            return {
                elevation: Math.round(Math.max(0, Math.min(1620, finalElev))),
                flightTime: Math.round(flightTime),
                charge: effectiveCharge,
                distance: dist,
                ownHeight: oh,
                targetHeight: th,
                rangeCorrection: Math.round(rangeCorr),
                heightCorrection: Math.round(heightCorr)
            };
        }

        const up = ud.upper;
        const low = ud.lower;

        const elevInterp = up[1] + ((low[1] - up[1]) / (low[0] - up[0])) * (dist - up[0]);
        const t1 = up[4] || 0;
        const t2 = low[4] || 0;
        const flightTimeInterp = t1 + ((t2 - t1) / (low[0] - up[0])) * (dist - up[0]);
        const hCorrUp = up[2] || 0;
        const hCorrLow = low[2] || 0;
        const heightCorrInterp = hCorrUp + ((hCorrLow - hCorrUp) / (low[0] - up[0])) * (dist - up[0]);
        const heightCorrectionFinal = (heightDiff / 100) * heightCorrInterp;
        finalElev = elevInterp + heightCorrectionFinal;
        rangeCorr = elevInterp;

        return {
            elevation: Math.round(Math.max(0, Math.min(1620, finalElev))),
            flightTime: Math.round(flightTimeInterp),
            charge: effectiveCharge,
            distance: dist,
            ownHeight: oh,
            targetHeight: th,
            rangeCorrection: Math.round(rangeCorr),
            heightCorrection: Math.round(heightCorrectionFinal)
        };
    }

    function addToHistory(res, type = 'Элеватор', extra = null) {
        const entry = {
            id: Date.now(),
            weapon: getCurrentDataSource()?.name || currentWeapon,
            distance: res.distance,
            charge: res.charge,
            elevation: res.elevation,
            flightTime: res.flightTime,
            ownHeight: res.ownHeight,
            targetHeight: res.targetHeight,
            rangeCorr: res.rangeCorrection,
            heightCorr: res.heightCorrection,
            type: type,
            calculatedAt: new Date().toLocaleString('ru-RU', { hour12: false })
        };
        if (extra) {
            entry.profileTumbler = extra.profileTumbler;
            entry.delayTumbler = extra.delayTumbler;
        }
        calculationHistory.unshift(entry);
        if (calculationHistory.length > 50) calculationHistory.pop();
        updateHistoryDisplay();
    }

    function updateHistoryDisplay() {
        const tbody = document.getElementById('history-table-body');
        tbody.innerHTML = '';
        const no = document.getElementById('no-history');
        const table = document.getElementById('history-table');
        if (calculationHistory.length === 0) { no.style.display = 'block'; table.style.display = 'none'; document.getElementById('history-count').innerText = '0'; return; }
        no.style.display = 'none'; table.style.display = 'table';
        document.getElementById('history-count').innerText = calculationHistory.length;
        calculationHistory.forEach(e => {
            let row = tbody.insertRow();
            row.style.cursor = 'pointer';
            row.addEventListener('click', () => showDetailModal(e));
            row.innerHTML = `<td>${e.weapon}</td><td>${Math.round(e.distance)}</td><td>${e.charge}</td><td>${e.elevation}</td><td>${e.flightTime || 0} сек</td>`;
        });
    }

    function showDetailModal(entry) {
        const modal = document.getElementById('detail-modal');
        const container = document.getElementById('modal-detail');
        let html = '';

        if (Array.isArray(entry)) {
            html = '<h4 style="margin-bottom:12px;">📋 Общая история расчётов</h4><hr>';
            entry.forEach((e, index) => {
                html += `
                    <div class="history-detail-item">
                        <p><strong>#${index + 1}</strong> — ${e.weapon || 'Орудие'} (${e.type || 'Элеватор'})</p>
                        <p>📏 Дальность: ${Math.round(e.distance)} м</p>
                        <p>🔢 Заряд: ${e.charge}</p>
                        <p>🎯 Элеватор: ${e.elevation}</p>
                        ${e.profileTumbler !== undefined ? `<p>🔘 Тумблер профиля: ${e.profileTumbler}</p>` : ''}
                        ${e.delayTumbler !== undefined ? `<p>⏱ Тумблер задержки: ${e.delayTumbler}</p>` : ''}
                        <p>⏱ Время полёта: ${e.flightTime || 0} сек</p>
                        <p>📐 Поправка на дистанцию: ${Math.round(e.rangeCorr || 0)}</p>
                        <p>📐 Поправка на высоту: ${Math.round(e.heightCorr || 0)}</p>
                        <p>🕒 Время расчёта: ${e.calculatedAt || '—'}</p>
                    </div>
                `;
            });
        } else {
            html = `
                <p><strong>Орудие:</strong> ${entry.weapon}</p>
                <p><strong>Тип расчёта:</strong> ${entry.type || 'Элеватор'}</p>
                <p><strong>Дальность до цели:</strong> ${Math.round(entry.distance)} м</p>
                <p><strong>Своя высота:</strong> ${entry.ownHeight || 0} м</p>
                <p><strong>Высота цели:</strong> ${entry.targetHeight || 0} м</p>
                <p><strong>Поправка на дистанцию:</strong> ${Math.round(entry.rangeCorr || 0)}</p>
                <p><strong>Поправка на высоту:</strong> ${Math.round(entry.heightCorr || 0)}</p>
                <p><strong>Полетное время:</strong> ${entry.flightTime || 0} сек</p>
                <p><strong>Заряд:</strong> ${entry.charge}</p>
                <p><strong>Элеватор:</strong> ${entry.elevation}</p>
                ${entry.profileTumbler !== undefined ? `<p><strong>Тумблер профиля:</strong> ${entry.profileTumbler}</p>` : ''}
                ${entry.delayTumbler !== undefined ? `<p><strong>Тумблер задержки:</strong> ${entry.delayTumbler}</p>` : ''}
                <p><strong>Время расчёта:</strong> ${entry.calculatedAt || '—'}</p>
            `;
        }
        container.innerHTML = html;
        modal.style.display = 'flex';
    }

    window.closeModal = function() {
        document.getElementById('detail-modal').style.display = 'none';
    };

    async function shareHistoryWithQR() {
        if (calculationHistory.length === 0) {
            alert('Нет истории для публикации!');
            return;
        }

        try {
            const result = await saveHistoryToGist(calculationHistory);
            if (!result.success) {
                alert('Ошибка сохранения: ' + result.error);
                return;
            }

            const baseUrl = window.location.href.split('?')[0];
            let viewUrl = baseUrl.replace(/app\.html/i, 'veiw.html');
            if (viewUrl === baseUrl) {
                viewUrl = baseUrl + '?id=' + result.gistId;
            } else {
                viewUrl = viewUrl + '?id=' + result.gistId;
            }

            document.getElementById('qr-link-display').textContent = viewUrl;
            const container = document.getElementById('qr-code-container');
            container.innerHTML = '';
            try {
                new QRCode(container, {
                    text: viewUrl,
                    width: 200,
                    height: 200,
                    colorDark: '#1e2b3a',
                    colorLight: '#ffffff'
                });
            } catch (e) {
                container.innerHTML = '<p style="color:red;">Ошибка генерации QR-кода</p>';
            }
            document.getElementById('qr-modal').style.display = 'flex';
        } catch (error) {
            alert('Ошибка публикации: ' + error.message);
        }
    }

    window.closeQRModal = function() {
        document.getElementById('qr-modal').style.display = 'none';
    };

    async function loadSavedHistory() {
        const savedGistId = localStorage.getItem('current_gist_id');
        if (!savedGistId) return;
        const result = await loadHistoryFromGist(savedGistId);
        if (result.success && result.history && result.history.length > 0) {
            calculationHistory = result.history;
            updateHistoryDisplay();
            console.log('✅ История загружена из Gist:', result.history.length, 'записей');
        }
    }

    function loadSharedHistory() {
        const params = new URLSearchParams(window.location.search);
        const sharedId = params.get('id') || params.get('shared');
        if (!sharedId) return;

        const loadingDiv = document.createElement('div');
        loadingDiv.innerHTML = '<div style="text-align:center;padding:20px;">⏳ Загрузка истории...</div>';
        document.getElementById('modal-detail').innerHTML = '';
        document.getElementById('modal-detail').appendChild(loadingDiv);
        document.getElementById('detail-modal').style.display = 'flex';

        loadHistoryFromGist(sharedId).then(result => {
            if (result.success && result.history && result.history.length > 0) {
                showDetailModal(result.history);
                window.history.replaceState({}, document.title, window.location.pathname);
            } else {
                alert('Не удалось загрузить историю. Возможно, ссылка недействительна.');
                closeModal();
            }
        }).catch(error => {
            alert('Ошибка загрузки: ' + error.message);
            closeModal();
        });
    }

    function updateUIForTrajectory() {
        const toggle = document.getElementById('trajectory-toggle');
        const labelSpan = document.getElementById('trajectory-label');
        const statusSpan = document.getElementById('trajectory-status');
        const redpolyBtn = document.getElementById('calculate-redpoly');

        if (!hasWeaponData()) {
            labelSpan.innerHTML = '<i class="fas fa-chart-line"></i> Нет данных';
            statusSpan.innerHTML = '⚠️ Заполните данные для орудия';
            toggle.checked = false;
            redpolyBtn.style.display = 'none';
            return;
        }

        if (isFlatTrajectory) {
            labelSpan.innerHTML = '<i class="fas fa-chart-line"></i> Настильная стрельба';
            statusSpan.innerHTML = '🎯 Настильная стрельба';
            toggle.checked = true;
            redpolyBtn.style.display = 'none';
        } else {
            labelSpan.innerHTML = '<i class="fas fa-chart-line"></i> Мортирная стрельба';
            statusSpan.innerHTML = '⚡ Мортирная стрельба';
            toggle.checked = false;
            if (currentWeapon === '2S19' && mortarData['2S19']) {
                redpolyBtn.style.display = 'flex';
            } else {
                redpolyBtn.style.display = 'none';
            }
        }
        updateChargeRanges();
        validateDistanceInput();
    }

    function updateChargeRanges() {
        const grid = document.getElementById('ranges-grid');
        grid.innerHTML = '';
        const src = getCurrentDataSource();
        if (src && src.ranges) {
            src.ranges.forEach(r => {
                const div = document.createElement('div');
                div.className = 'range-item';
                div.innerHTML = `<span class="charge">Заряд ${r.charge}</span>: ${r.range}`;
                grid.appendChild(div);
            });
        } else {
            const div = document.createElement('div');
            div.className = 'range-item';
            div.innerHTML = '⚠️ Нет данных для выбранного орудия';
            grid.appendChild(div);
        }
    }

    function updateWeaponList() {
        const list = document.getElementById('weapon-list');
        list.innerHTML = '';
        const weapons = getAvailableWeapons();
        
        if (weapons.length === 0) {
            const div = document.createElement('div');
            div.className = 'weapon-item';
            div.innerHTML = '⚠️ Нет данных. Заполните mortarData или flatData';
            list.appendChild(div);
            return;
        }

        weapons.forEach(weapon => {
            const div = document.createElement('div');
            div.className = 'weapon-item';
            if (weapon === currentWeapon) div.classList.add('active');
            div.setAttribute('data-weapon', weapon);
            div.textContent = getWeaponName(weapon);
            div.addEventListener('click', function(e) {
                e.stopPropagation();
                selectWeapon(weapon);
                document.getElementById('weapon-list').classList.remove('show');
            });
            list.appendChild(div);
        });
    }

    function selectWeapon(weapon) {
        currentWeapon = weapon;
        if (isFlatTrajectory && !flatData[weapon]) {
            isFlatTrajectory = false;
        }
        if (!isFlatTrajectory && !mortarData[weapon]) {
            isFlatTrajectory = true;
        }
        const src = getCurrentDataSource();
        document.getElementById('selected-weapon').innerText = src?.name || weapon;
        updateWeaponList();
        updateUIForTrajectory();
        validateDistanceInput();
    }

    // Инициализация списка орудий
    const weapons = getAvailableWeapons();
    if (weapons.length > 0) {
        currentWeapon = weapons[0];
        if (mortarData[currentWeapon]) {
            isFlatTrajectory = false;
        } else if (flatData[currentWeapon]) {
            isFlatTrajectory = true;
        }
        document.getElementById('selected-weapon').innerText = getWeaponName(currentWeapon);
        updateWeaponList();
    }

    // Обработчики событий
    document.getElementById('auto-charge-toggle').addEventListener('change', function() {
        const isAuto = this.checked;
        document.getElementById('charge-input-group').style.display = isAuto ? 'none' : 'block';
        validateDistanceInput();
    });

    document.getElementById('charge').addEventListener('change', function() {
        validateDistanceInput();
    });

    document.getElementById('distance').addEventListener('input', function() {
        validateDistanceInput();
    });

    document.getElementById('trajectory-toggle').addEventListener('change', function(e) {
        isFlatTrajectory = e.target.checked;
        if (isFlatTrajectory && !flatData[currentWeapon]) {
            alert('Нет данных для настильной стрельбы у этого орудия');
            e.target.checked = false;
            isFlatTrajectory = false;
        }
        if (!isFlatTrajectory && !mortarData[currentWeapon]) {
            alert('Нет данных для мортирной стрельбы у этого орудия');
            e.target.checked = true;
            isFlatTrajectory = true;
        }
        updateUIForTrajectory();
    });

    document.getElementById('calculate-mortar').addEventListener('click', function() {
        if (!hasWeaponData()) {
            alert('Нет данных для выбранного орудия! Заполните mortarData или flatData.');
            return;
        }
        if (!validateDistanceInput()) {
            alert('Некорректная дальность! Проверьте введенное значение.');
            return;
        }
        let dist = parseFloat(document.getElementById('distance').value);
        let oh = parseFloat(document.getElementById('own-height').value) || 0;
        let th = parseFloat(document.getElementById('target-height').value) || 0;
        let auto = document.getElementById('auto-charge-toggle').checked;
        let charge = auto ? null : parseInt(document.getElementById('charge').value);
        try {
            let res = calculateFull(dist, oh, th, charge);
            document.getElementById('mortar-mode').innerText = isFlatTrajectory ? 'Настильный' : 'Мортирный';
            document.getElementById('mortar-charge').innerText = res.charge;
            document.getElementById('mortar-flight-time').innerText = res.flightTime + ' сек';
            document.getElementById('mortar-elevation').innerText = res.elevation;
            document.getElementById('results-mortar').classList.add('active');
            document.getElementById('results-redpoly').classList.remove('active');
            addToHistory(res, 'Элеватор');
        } catch (e) {
            alert('Ошибка расчета: ' + e.message);
        }
    });

    document.getElementById('calculate-redpoly').addEventListener('click', function() {
        if (currentWeapon !== '2S19') {
            alert('Краснополь доступен только для орудия 2С19 Мста-С');
            return;
        }
        if (isFlatTrajectory) {
            alert('Краснополь доступен ТОЛЬКО при мортирной стрельбе!');
            return;
        }
        if (!mortarData['2S19']) {
            alert('Нет данных для мортирной стрельбы 2С19!');
            return;
        }
        if (!validateDistanceInput()) {
            alert('Некорректная дальность!');
            return;
        }
        let dist = parseFloat(document.getElementById('distance').value);
        let oh = parseFloat(document.getElementById('own-height').value) || 0;
        let th = parseFloat(document.getElementById('target-height').value) || 0;
        try {
            let res = calculateFull(dist, oh, th);
            
            // Определяем ближайший тумблер профиля
            const profiles = [
                { t: 1, angle: '70-80°', elev: 1350 },
                { t: 2, angle: '70°', elev: 1260 },
                { t: 3, angle: '60°', elev: 1080 },
                { t: 4, angle: '50°', elev: 900 }
            ];
            let closest = profiles.reduce((p, c) => Math.abs(c.elev - res.elevation) < Math.abs(p.elev - res.elevation) ? c : p);
            let delay = Math.min(8, Math.max(1, Math.round((2 / 3 * res.flightTime) / 6)));
            
            document.getElementById('redpoly-charge').innerText = res.charge;
            document.getElementById('redpoly-flight-time').innerText = res.flightTime + ' сек';
            document.getElementById('redpoly-elevator').innerText = res.elevation;
            document.getElementById('redpoly-delay').innerText = delay;
            
            const tumblerContainer = document.getElementById('redpoly-tumblers');
            tumblerContainer.innerHTML = '';
            
            profiles.forEach(p => {
                const isActive = p.t === closest.t;
                const div = document.createElement('div');
                div.style.cssText = `
                    flex: 1 1 80px;
                    background: ${isActive ? 'var(--red-poly)' : 'rgba(255,255,255,0.7)'};
                    color: ${isActive ? 'white' : 'var(--primary)'};
                    border-radius: 16px;
                    padding: 12px 8px;
                    text-align: center;
                    box-shadow: ${isActive ? '0 4px 12px rgba(178,59,44,0.4)' : '0 2px 6px rgba(0,0,0,0.05)'};
                    border: ${isActive ? '2px solid var(--red-poly)' : '1px solid rgba(0,0,0,0.05)'};
                    transition: all 0.2s;
                `;
                div.innerHTML = `
                    <div style="font-size:0.7rem; opacity:0.7;">Тумблер ${p.t}</div>
                    <div style="font-size:1.1rem; font-weight:700;">${p.elev}</div>
                    <div style="font-size:0.65rem; opacity:0.6;">${p.angle}</div>
                    ${isActive ? '<div style="font-size:0.6rem; margin-top:4px; background:rgba(255,255,255,0.2); border-radius:12px; padding:2px 8px;">✅ Рекомендуемый</div>' : ''}
                `;
                tumblerContainer.appendChild(div);
            });
            
            document.getElementById('results-redpoly').classList.add('active');
            document.getElementById('results-mortar').classList.remove('active');
            
            addToHistory(res, 'Краснополь', { 
                profileTumbler: closest.t,
                delayTumbler: delay
            });
        } catch (e) {
            alert('Ошибка расчета: ' + e.message);
        }
    });

    document.getElementById('reset-calculator').addEventListener('click', function() {
        document.getElementById('distance').value = '1100';
        document.getElementById('own-height').value = '0';
        document.getElementById('target-height').value = '0';
        document.getElementById('charge').value = '0';
        validateDistanceInput();
        document.getElementById('results-mortar').classList.remove('active');
        document.getElementById('results-redpoly').classList.remove('active');
    });

    document.getElementById('full-restart').addEventListener('click', function() {
        showAppConfirm('Полный перезапуск? Вся история будет удалена.', function() {
            calculationHistory = [];
            updateHistoryDisplay();
            localStorage.removeItem('current_gist_id');
            
            if (weapons.length > 0) {
                currentWeapon = weapons[0];
                if (mortarData[currentWeapon]) {
                    isFlatTrajectory = false;
                } else if (flatData[currentWeapon]) {
                    isFlatTrajectory = true;
                }
                document.getElementById('selected-weapon').innerText = getWeaponName(currentWeapon);
                updateWeaponList();
            }
            updateUIForTrajectory();
            document.getElementById('distance').value = '1100';
            document.getElementById('own-height').value = '0';
            document.getElementById('target-height').value = '0';
            document.getElementById('charge').value = '0';
            document.getElementById('auto-charge-toggle').checked = true;
            document.getElementById('charge-input-group').style.display = 'none';
            validateDistanceInput();
            document.getElementById('results-mortar').classList.remove('active');
            document.getElementById('results-redpoly').classList.remove('active');
        });
    });

    document.getElementById('share-history-btn').addEventListener('click', shareHistoryWithQR);

    document.getElementById('weapon-btn').addEventListener('click', function(e) {
        e.preventDefault();
        e.stopPropagation();
        const list = document.getElementById('weapon-list');
        list.classList.toggle('show');
    });

    document.addEventListener('click', function(e) {
        const list = document.getElementById('weapon-list');
        const btn = document.getElementById('weapon-btn');
        if (list.classList.contains('show') && 
            !list.contains(e.target) && 
            !btn.contains(e.target)) {
            list.classList.remove('show');
        }
    });

    loadSavedHistory();
    loadSharedHistory();

    updateUIForTrajectory();
    validateDistanceInput();
}

