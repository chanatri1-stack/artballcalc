class UpdateManager {
    constructor() {
        this.VERSION_URL = 'https://raw.githubusercontent.com/chanatri1-stack/artballcalc/main/version.json';
        this.CURRENT_VERSION = APP_VERSION;
    }
    
    async checkForUpdate() {
        try {
            const response = await fetch(this.VERSION_URL + '?t=' + Date.now());
            if (!response.ok) return { hasUpdate: false };
            const data = await response.json();
            const hasUpdate = this.compareVersions(this.CURRENT_VERSION, data.version) < 0;
            return {
                hasUpdate: hasUpdate,
                currentVersion: this.CURRENT_VERSION,
                newVersion: data.version || 'неизвестно'
            };
        } catch(e) {
            console.error('Ошибка проверки обновлений:', e);
            return { hasUpdate: false };
        }
    }
    
    compareVersions(v1, v2) {
        const parts1 = v1.split('.').map(Number);
        const parts2 = v2.split('.').map(Number);
        for (let i = 0; i < Math.max(parts1.length, parts2.length); i++) {
            const n1 = parts1[i] || 0;
            const n2 = parts2[i] || 0;
            if (n1 !== n2) return n1 - n2;
        }
        return 0;
    }
}

