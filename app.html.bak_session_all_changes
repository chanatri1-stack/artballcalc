async function saveHistoryToGist(historyData) {
    const gistId = localStorage.getItem('current_gist_id');
    const method = gistId ? 'PATCH' : 'POST';
    const url = gistId 
        ? `https://api.github.com/gists/${gistId}`
        : 'https://api.github.com/gists';

    const payload = {
        description: 'История расчётов артиллерийского калькулятора',
        public: false,
        files: {
            'history.json': {
                content: JSON.stringify({
                    version: APP_VERSION,
                    timestamp: new Date().toISOString(),
                    history: historyData
                }, null, 2)
            }
        }
    };

    try {
        const response = await fetch(url, {
            method: method,
            headers: {
                'Authorization': `token ${SECRET_KEY}`,
                'Content-Type': 'application/json',
                'Accept': 'application/json'
            },
            body: JSON.stringify(payload)
        });

        if (!response.ok) throw new Error(`GitHub API error: ${response.status}`);

        const data = await response.json();
        if (!gistId) localStorage.setItem('current_gist_id', data.id);
        return { success: true, gistId: data.id, htmlUrl: data.html_url };
    } catch (error) {
        console.error('Ошибка сохранения в Gist:', error);
        return { success: false, error: error.message };
    }
}

async function loadHistoryFromGist(gistId) {
    try {
        const response = await fetch(`https://api.github.com/gists/${gistId}`, {
            headers: { 'Accept': 'application/json' }
        });
        if (!response.ok) throw new Error(`GitHub API error: ${response.status}`);
        const gist = await response.json();
        const files = gist.files;
        let content = null;
        for (const filename in files) {
            if (filename.endsWith('.json')) {
                content = files[filename].content;
                break;
            }
        }
        if (!content) throw new Error('Файл history.json не найден в Gist');
        const data = JSON.parse(content);
        return {
            success: true,
            history: data.history || [],
            version: data.version || 'неизвестно',
            timestamp: data.timestamp || null
        };
    } catch (error) {
        console.error('Ошибка загрузки из Gist:', error);
        return { success: false, error: error.message };
    }
}

